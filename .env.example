# Copy to .env and fill in. The real .env is git-ignored. Never commit secrets.

POSTGRES_USER=recipes
# Use a long random value in production, for example: openssl rand -hex 24
# (hex avoids characters that break the database address in compose.yaml)
POSTGRES_PASSWORD=change-me
POSTGRES_DB=recipes

# Production VM only:
# TUNNEL_TOKEN=paste-cloudflare-tunnel-token
# COMPOSE_PROFILES=prod
